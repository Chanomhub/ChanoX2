{
  "name": "chanox2",
  "version": "1.5.7",
  "description": "Desktop application for ChanomHub",
  "author": {
    "name": "ChanomHub",
    "email": "contact@chanomhub.com"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:prod": "npm run build && cross-env NODE_ENV=production electron .",
    "prepare": "husky"
  },
  "dependencies": {
    "@chanomhub/sdk": "1.2.8",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.90.21",
    "@types/dompurify": "^3.2.0",
    "ably": "^2.17.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "i18next": "^25.8.7",
    "layer-pack-node": "^0.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.6.0",
    "electron-builder": "^26.7.0",
    "husky": "^9.1.7",
    "lucide-react": "^0.469.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "wait-on": "^9.0.4"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "nsfwjs": "^4.2.1"
  },
  "build": {
    "appId": "com.chanomhub.chanox2",
    "productName": "ChanoX2",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "public/installer.nsh",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "license": "public/license.txt",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "ChanomHub"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "flatpak",
        "rpm"
      ],
      "category": "Game",
      "icon": "public/icon.png"
    },
    "flatpak": {
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=xdg-download",
        "--filesystem=/tmp",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "public/icon.png"
    },
    "dmg": {
      "background": "public/dmg-background.png",
      "icon": "public/icon.png",
      "iconSize": 100,
      "contents": [
        {
          "x": 180,
          "y": 170
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 400
      }
    }
  },
  "private": true
}